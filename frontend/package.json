{
  "name": "sitelytics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --watch-path=server server/dev.ts",
    "dev:client": "rsbuild dev",
    "build:fastify": "node --import tsx scripts/build-server.ts",
    "build": "rsbuild build && pnpm build:fastify",
    "start": "NODE_ENV=production node dist/fastify/server/index.js"
  },
  "dependencies": {
    "@fastify/middie": "^9.0.0",
    "@fastify/static": "^8.0.0",
    "fastify": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.1.1",
    "recharts": "^3.8.0"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.6.7",
    "@rsbuild/plugin-react": "^1.4.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "esbuild": "^0.27.3",
    "tsx": "^4.0.0",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@11.20.0"
}
